{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Knowledge-base entry",
  "description": "One event, six fields, every field backed by a quote or marked inferred.",
  "type": "object",
  "required": ["id", "title", "source", "fields", "review"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "description": "Stable identifier. Never reused, never renumbered."
    },
    "title": { "type": "string", "maxLength": 24 },
    "source": {
      "type": "object",
      "required": ["work", "quotes"],
      "additionalProperties": false,
      "properties": {
        "work": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "revision": { "type": ["string", "null"] },
        "quotes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Verbatim excerpts. Field evidence must be a substring of one of these."
        }
      }
    },
    "fields": {
      "type": "object",
      "required": ["人物", "时间", "地点", "起因", "经过", "结果"],
      "additionalProperties": false,
      "properties": {
        "人物": { "$ref": "#/definitions/field" },
        "时间": { "$ref": "#/definitions/field" },
        "地点": { "$ref": "#/definitions/field" },
        "起因": { "$ref": "#/definitions/field" },
        "经过": { "$ref": "#/definitions/field" },
        "结果": { "$ref": "#/definitions/field" }
      }
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["draft", "pending", "approved"] },
        "by": { "type": ["string", "null"] },
        "at": { "type": ["string", "null"] }
      }
    },
    "notes": {
      "type": "string",
      "description": "Disagreements between sources. Stored, never rendered."
    }
  },
  "definitions": {
    "field": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidence": { "type": ["string", "null"] },
        "inferred": { "type": "boolean" }
      }
    }
  }
}
