// PLE TinyLM inference on the ESP32-S3.
//
// The 28.9M-param model (14.9MB, 4-bit) lives in a flash 'model' partition,
// memory-mapped. Placement follows reads-per-token rather than what happens to
// fit:
//
//   flash   PLE table + token embedding   one row of the 25.2M-parameter
//                                         table per token
//   PSRAM   staged int8 core + head, KV   read once per position
//   SRAM    scratch + norm vectors        touched many times per token
//
// The logits array stays in PSRAM: 25,353 floats is 99 KiB, and the argmax
// reads it once per token.
//
// Same llm.h that is verified against PyTorch on the host; only the platform
// hooks differ here.

#include "esp_partition.h"
#include "esp_heap_caps.h"
#include "esp_timer.h"
#include "esp_system.h"
#include <Preferences.h>
#include <ESPmDNS.h>

// int8 activations, required by the staged int8 kernel. Not bit-exact against
// the fp32 golden; verify.c must be built without this flag. Validation CE cost
// (runtime/host_verify/ppl.c, 32,768 predictions): 2.4793 -> 2.4796, ppl 11.93 / 11.94.
#define LLM_INT8_ACT 1
#define LLM_PROFILE 1
#define LLM_PROFILE_NOW() esp_timer_get_time()
#include "../../runtime/llm.h"
#include "generated/vocab.h"
#include "bpe_encode.h"

// On-device 1.54" ST7789 (expansion board's 8-pin TFT socket). display.h now
// carries a 16x16 CJK font (generated/cjk_font.h), so the story renders on the
// panel as well as over serial. Set to 0 for a serial-only run.
#define USE_DISPLAY 1
#if USE_DISPLAY
#include "display.h"
#endif

// On-device web UI: the board raises its own access point, so no router
// credentials live in the firmware and the demo works on any desk. Generation
// moves to its own task (~35 s per story) and the web server keeps serving
// throughout; see loop() below.
#define ENABLE_WIFI 1
#if ENABLE_WIFI
#include <WiFi.h>
#include <WebServer.h>
#define AP_SSID "PLE-TinyLM"
#define AP_PASS "tinystory"
#endif

// Chinese model (artifacts/zh): the head is NOT staged to int8 - core (3.0MB)
// + head (3.15MB) + KV would not fit the 8MB PSRAM. The head runs straight
// from its flash-resident int4 rows instead.
#define STAGE_HEAD_INT8 0

// Device-side context cap. Stories stop at EOT well before this (~130-230
// tokens for 150-200 characters); capping KV at 256 instead of the trained
// 512 is what makes the fp32 KV cache fit alongside the staged core.
#define DEV_SEQ 256

// Repetition penalty (CTRL-style), applied before the argmax: every token
// seen in the prompt or generated so far has its logit divided by this when
// positive and multiplied when negative, once per unique token. Must match
// sample.py's repetition_penalty exactly - acceptance parity relies on it.
// 100 (= 1.0x) disables the penalty entirely. The percent form exists because
// the preprocessor cannot compare float literals in #if.
#define REPETITION_PENALTY_PCT 130
#define REPETITION_PENALTY (REPETITION_PENALTY_PCT / 100.0f)

static const int PROMPT_IDS[] = {524, 258}; // "一天，" (zh-story4 tokenizer)
// Backstop only: the model closes its own story with the end-of-text token
// (id 0) and the loop below stops there, which lands near 120 tokens for a
// 150-200 character Chinese story.
static const int N_GENERATE = 230;

// Openings for the on-device web button. Priming every run with the same two
// tokens was half the reason "再来一篇" kept producing the same story; these are
// all inside the training register and short enough for the BPE encoder to take
// them at run time. A failed encode falls back to PROMPT_IDS.
static const char *OPENERS[] = {
    "一天，", "从前，", "早上，", "天黑了，", "下雨了，", "放学的时候，",
};

// ---- sampling --------------------------------------------------------------
// The decode loop used to be a pure argmax, so identical weights, an identical
// prompt and no randomness decoded to the identical story every run. Sampling
// from the top-k with a fresh hardware seed per story is what makes each click
// different. SAMPLE_TOP_K 1 restores the greedy path (the mode the host
// acceptance check compares against sample.py).
#define SAMPLE_TOP_K 20
#define SAMPLE_TEMP 0.70f
// Greedy decoding never ends early (the argmax only picks EOT when the model is
// sure); sampling occasionally draws it at token 20 and returns a one-sentence
// "story". EOT is masked for the first MIN_STORY_TOKENS steps so every click
// yields a full piece.
#define MIN_STORY_TOKENS 70

// ---- serial control channel ------------------------------------------------
// scripts/board_openai.py drives the board over USB: it sends a prompt as token
// ids ("P 524 258"), the board answers <<<BEGIN, streams the generated bytes,
// then <<<END. The ids are from artifacts/zh/tokenizer.json, the same 16384-token
// vocabulary generated/vocab.h was built from, so the host can prime the model
// with any Chinese opening instead of the baked-in one.
#define SERIAL_PROMPT_MAX 32
static int g_prompt[SERIAL_PROMPT_MAX];
static volatile int g_prompt_n = 0;       // 0 -> use PROMPT_IDS
static volatile bool g_framed = false;    // this run belongs to the API host
static volatile bool g_mute_serial = false;  // prompt ids stay off the wire

// Station credentials live in NVS, written once with the "W <ssid> <pass>"
// serial command, so the sketch carries no network secrets. Empty means the
// board stays an access point and the OpenAI endpoint is reachable only there.
static String g_sta_ssid, g_sta_pass;
static Preferences g_prefs;

Model model;
Scratch s;

// ---- allocation ------------------------------------------------------------
// Allocations are strict because memory placement is part of the runtime
// configuration. Allocation failure stops initialization.
static size_t psram_used = 0, sram_used = 0;

// The two LLM_Q8_MAX_INPUT int8 activation buffers (matvec_q8, matvec_par),
// which are static and so absent from the totals above. Together these report
// the managed hot set, not total SRAM usage; the free-SRAM figure printed at
// boot is the overall diagnostic.
#define STATIC_SRAM_BYTES (2 * LLM_Q8_MAX_INPUT)

static void *ps(size_t n) {
  void *p = heap_caps_malloc(n, MALLOC_CAP_SPIRAM);
  if (p) psram_used += n;
  return p;
}
static void *ps_or_die(size_t n, const char *what) {
  void *p = ps(n);
  if (!p) {
    Serial.printf("FATAL: required PSRAM allocation failed: %s (%u bytes)\n",
                  what, (unsigned)n);
    while (1) delay(1000);
  }
  return p;
}
static void *sram_or_die(size_t n, const char *what) {
  void *p = heap_caps_malloc(n, MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
  if (!p) {
    Serial.printf("FATAL: required SRAM allocation failed: %s (%u bytes)\n",
                  what, (unsigned)n);
    while (1) delay(1000);
  }
  sram_used += n;
  return p;
}

// ---- dual-core int8 matvec -------------------------------------------------
// Serves both hooks. Below ~128 rows the task notify round trip costs more than
// the split saves, so small tensors run single-core.
static TaskHandle_t worker_h, main_h;
static const QT *job_t;
static const int8_t *job_xq;
static float job_xs;
static float *job_y;
static int job_split;

static void worker_main(void *) {
  for (;;) {
    ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
    matvec_i8_range(job_t, job_xq, job_xs, job_y, 0, job_split);
    xTaskNotifyGive(main_h);
  }
}

static void matvec_par(const QT *t, const float *x, float *y) {
  static int8_t xq[LLM_Q8_MAX_INPUT];
  float xs;
  if (t->w8 == NULL || t->rows < 128) { MATVEC(t, x, y); return; }
  quantize_act(x, t->cols, xq, &xs);   // once; both cores read the result
  // The caller need not be setup()'s task: the web UI generates from its own
  // task, so the completion notification has to target whoever called us.
  main_h = xTaskGetCurrentTaskHandle();
  job_t = t; job_xq = xq; job_xs = xs; job_y = y; job_split = t->rows / 2;
  xTaskNotifyGive(worker_h);
  matvec_i8_range(t, xq, xs, y, job_split, t->rows);
  ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
}

// Copy RMSNorm weights from mapped flash to internal SRAM.
static void copy_norms_to_sram() {
  Cfg *c = &model.c;
  int D = c->dim, L = c->n_layers, P = c->ple_dim;
  const float **vecs[3 * 32 + 2];
  int sizes[3 * 32 + 2], n_vec = 0;
  vecs[n_vec] = &model.ple_proj_norm; sizes[n_vec++] = P;
  for (int l = 0; l < L; l++) {
    vecs[n_vec] = &model.attn_norm[l]; sizes[n_vec++] = D;
    vecs[n_vec] = &model.ffn_norm[l];  sizes[n_vec++] = D;
    vecs[n_vec] = &model.ple_norm[l];  sizes[n_vec++] = D;
  }
  vecs[n_vec] = &model.out_norm; sizes[n_vec++] = D;
  for (int i = 0; i < n_vec; i++) {
    size_t bytes = (size_t)sizes[i] * sizeof(float);
    void *dst = sram_or_die(bytes, "norm vector");
    memcpy(dst, *vecs[i], bytes);
    *vecs[i] = (const float *)dst;
  }
  Serial.printf("norms  -> SRAM   %d vectors\n", n_vec);
}

static void alloc_scratch() {
  Cfg *c = &model.c;
  int D = c->dim, L = c->n_layers, P = c->ple_dim, F = c->ffn, S = c->seq_len;
  // hot working set -> internal SRAM
  s.x     = (float *)sram_or_die(D * 4, "x");
  s.h     = (float *)sram_or_die((F > D ? F : D) * 4, "h");
  s.qkv   = (float *)sram_or_die(3 * D * 4, "qkv");
  s.att   = (float *)sram_or_die(D * 4, "att");
  s.g1    = (float *)sram_or_die(F * 4, "g1");
  s.g2    = (float *)sram_or_die((P > F ? P : F) * 4, "g2");
  s.ple   = (float *)sram_or_die(L * P * 4, "ple");
  s.tmpP  = (float *)sram_or_die(L * P * 4, "tmpP");
  s.trow  = (float *)sram_or_die(L * P * 4, "trow");
  s.scores = (float *)sram_or_die(S * 4, "scores");
  // logits: out_vocab floats, 99 KiB here, read once per token. Left in PSRAM
  // rather than spend a fifth of internal SRAM on it.
  s.logits = (float *)ps_or_die((size_t)model.out_vocab * 4, "logits");
  // KV cache: sized for DEV_SEQ, not the trained seq_len (512). At 8 layers x
  // 256 x 192 fp32 this is 1.57MB per cache; at the full 512 it would be 3.15MB
  // each and the Chinese model would not fit PSRAM. llm_forward steps the
  // caches with s.kv_len, set below.
  s.kcache = (float *)ps_or_die((size_t)L * DEV_SEQ * D * 4, "kcache");
  s.vcache = (float *)ps_or_die((size_t)L * DEV_SEQ * D * 4, "vcache");
  s.kv_len = DEV_SEQ;
}

static void blink(uint8_t g) {
#ifdef RGB_BUILTIN
  rgbLedWrite(RGB_BUILTIN, 0, g, g / 3);
#endif
}

// ---- WiFi AP + web UI -----------------------------------------------------
// The board raises its own access point: no router credentials in the firmware.
// Generation runs in its own task because a story takes ~35 s and the server
// must keep answering while it does.
#if ENABLE_WIFI
static WebServer web(80);
static char *g_text, *g_resp;      // PSRAM: story text and one JSON reply
#define TEXT_CAP 4096
#define RESP_CAP 16384
static volatile int   g_len;
static volatile int   g_story_start;   // offset of the first generated byte
static volatile int   g_last_tokens;   // tokens decoded in the last run
static volatile bool  g_running;
static volatile float g_tok_s, g_ms;

static void generate_story();
static void gen_task(void *);

#include "web_page.h"
#include "wifi_page.h"

// Minimal JSON string escaping: the model emits quotes and newlines, and the
// page reads the text as JSON.
static void json_escape(const char *src, int n, char *dst, int cap) {
  int o = 0;
  for (int i = 0; i < n && o + 7 < cap; i++) {
    unsigned char c = (unsigned char)src[i];
    if (c == '"' || c == '\\') { dst[o++] = '\\'; dst[o++] = (char)c; }
    else if (c < 0x20) o += snprintf(dst + o, cap - o, "\\u%04x", c);
    else dst[o++] = (char)c;
  }
  dst[o] = 0;
}

static void handle_root() { web.send_P(200, "text/html; charset=utf-8", PAGE); }

// One story in its own task. `framed` marks a serial/API request: that run owns
// the serial line (no prompt echo, no trailing stats) so the host can parse it.
static void start_generation(bool framed) {
  g_framed = framed;
  g_len = 0;
  if (g_text) g_text[0] = 0;
  g_running = true;
  xTaskCreatePinnedToCore(gen_task, "gen", 8192, NULL, 1, NULL, 1);
}

static void handle_start() {
  if (g_running) { web.send(409, "application/json", "{\"ok\":0}"); return; }
  // Prime with a random opening from OPENERS; the encode can only fail if the
  // table itself is longer than the prompt limit, in which case the baked
  // PROMPT_IDS is still there as the fallback.
  const uint32_t n_open = sizeof(OPENERS) / sizeof(OPENERS[0]);
  const char *opener = OPENERS[esp_random() % n_open];
  uint16_t ids[SERIAL_PROMPT_MAX];
  const int n = bpe_encode((const uint8_t *)opener, strlen(opener), ids, SERIAL_PROMPT_MAX);
  g_prompt_n = 0;
  if (n > 0) {
    for (int i = 0; i < n; i++) g_prompt[i] = (int)ids[i];
    g_prompt_n = n;
  }
  web.send(200, "application/json", "{\"ok\":1}");
  start_generation(false);
}

static void handle_text() {
  int since = web.hasArg("since") ? web.arg("since").toInt() : 0;
  if (since < 0) since = 0;
  if (since > g_len) since = g_len;
  int o = snprintf(g_resp, RESP_CAP,
                   "{\"len\":%d,\"done\":%s,\"tps\":%.2f,\"ms\":%.0f,\"text\":\"",
                   g_len, g_running ? "false" : "true",
                   (double)g_tok_s, (double)g_ms);
  json_escape(g_text + since, g_len - since, g_resp + o, RESP_CAP - o - 3);
  strcat(g_resp, "\"}");
  web.send(200, "application/json; charset=utf-8", g_resp);
}

// Host control channel (scripts/board_openai.py):
//   P <id> <id> ...   start a story primed with those token ids
//   S                 start with the baked-in prompt
//   ?                 report state
// The story is framed with <<<BEGIN / <<<END; <<<BUSY and <<<ERR are the
// refusals. A newline ends a command, so the host can pipeline nothing and
// simply waits for the frame.
static char g_cmd[192];
static int g_cmd_n = 0;

static void handle_serial_line(char *line) {
  if (line[0] == 'P' || line[0] == 'p') {
    int ids[SERIAL_PROMPT_MAX], k = 0;
    char *p = line + 1;
    while (*p && k < SERIAL_PROMPT_MAX) {
      while (*p == ' ') p++;
      if (!*p) break;
      char *end;
      long v = strtol(p, &end, 10);
      if (end == p) break;
      if (v < 0 || v >= VOCAB_N) { Serial.println("<<<ERR id"); return; }
      ids[k++] = (int)v;
      p = end;
    }
    if (k == 0) { Serial.println("<<<ERR empty"); return; }
    if (g_running) { Serial.println("<<<BUSY"); return; }
    memcpy(g_prompt, ids, sizeof(int) * k);
    g_prompt_n = k;
    start_generation(true);
  } else if (line[0] == 'S' || line[0] == 's') {
    if (g_running) { Serial.println("<<<BUSY"); return; }
    g_prompt_n = 0;
    start_generation(true);
  } else if (line[0] == '?') {
    Serial.println(g_running ? "<<<BUSY" : "<<<IDLE");
  } else if (line[0] == 'W' || line[0] == 'w') {
    char *p = line + 1;
    while (*p == ' ') p++;
    char *sp = strchr(p, ' ');
    if (!sp) { Serial.println("<<<ERR W <ssid> <pass>"); return; }
    *sp = 0;
    g_sta_ssid = p;
    g_sta_pass = sp + 1;
    g_prefs.begin("wifi", false);
    g_prefs.putString("ssid", g_sta_ssid);
    g_prefs.putString("pass", g_sta_pass);
    g_prefs.end();
    WiFi.disconnect();
    WiFi.begin(g_sta_ssid.c_str(), g_sta_pass.c_str());
    Serial.printf("<<<WIFI %s\n", g_sta_ssid.c_str());
  } else if (line[0] == 'C' || line[0] == 'c') {
    Serial.printf("<<<STA %s ip %s\n",
                  WiFi.status() == WL_CONNECTED ? "up" : "down",
                  WiFi.localIP().toString().c_str());
  } else if (line[0] == 'E' || line[0] == 'e') {
    // Tokenize without generating: lets the host check the encoder against
    // tokenizers without burning 35 s on a story.
    char *p = line + 1;
    while (*p == ' ') p++;
    uint16_t ids[SERIAL_PROMPT_MAX];
    int n = bpe_encode((const uint8_t *)p, strlen(p), ids, SERIAL_PROMPT_MAX);
    if (n < 0) { Serial.println("<<<ERR long"); return; }
    Serial.print("<<<IDS");
    for (int i = 0; i < n; i++) Serial.printf(" %u", ids[i]);
    Serial.println();
  } else {
    Serial.println("<<<ERR cmd");
  }
}

// ---- WiFi provisioning portal ---------------------------------------------
// The access point is also the setup page: a phone joins PLE-TinyLM, opens
// /wifi, picks the router and the board stores the credentials in NVS. AP+STA
// keeps both entry points alive, and the same page works from the router side
// afterwards (http://<board-ip>/wifi).
static bool sta_connect_saved(uint32_t timeout_ms) {
  WiFi.begin(g_sta_ssid.c_str(), g_sta_pass.c_str());
  uint32_t t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < timeout_ms) delay(100);
  return WiFi.status() == WL_CONNECTED;
}

static void start_mdns_once() {
  static bool done = false;
  if (done) return;
  if (MDNS.begin("ple-tinystory")) {
    MDNS.addService("http", "tcp", 80);
    done = true;
    Serial.println("mdns : http://ple-tinystory.local/");
  }
}

static void handle_wifi_page() {
  web.send_P(200, "text/html; charset=utf-8", WIFI_PAGE);
}

static void handle_wifi_status() {
  bool up = WiFi.status() == WL_CONNECTED;
  char esc[128];
  json_escape(g_sta_ssid.c_str(), g_sta_ssid.length(), esc, sizeof(esc));
  String ip = up ? WiFi.localIP().toString() : String("0.0.0.0");
  snprintf(g_resp, RESP_CAP,
           "{\"saved\":%s,\"connected\":%s,\"ssid\":\"%s\",\"ip\":\"%s\",\"rssi\":%d,"
           "\"ap_ssid\":\"%s\",\"ap_ip\":\"%s\",\"mdns\":\"ple-tinystory.local\"}",
           g_sta_ssid.length() ? "true" : "false", up ? "true" : "false",
           esc, ip.c_str(), up ? (int)WiFi.RSSI() : 0, AP_SSID,
           WiFi.softAPIP().toString().c_str());
  web.send(200, "application/json; charset=utf-8", g_resp);
}

static void handle_wifi_scan() {
  int n = WiFi.scanNetworks(false, false);
  if (n < 0) n = 0;
  int used = snprintf(g_resp, RESP_CAP, "{\"nets\":[");
  int count = 0;
  for (int i = 0; i < n && count < 15; i++) {
    String s = WiFi.SSID(i);
    if (!s.length()) continue;
    char esc[128];
    json_escape(s.c_str(), s.length(), esc, sizeof(esc));
    used += snprintf(g_resp + used, RESP_CAP - used,
                     "%s{\"ssid\":\"%s\",\"rssi\":%d,\"enc\":%d}",
                     count ? "," : "", esc, (int)WiFi.RSSI(i),
                     WiFi.encryptionType(i) == WIFI_AUTH_OPEN ? 0 : 1);
    count++;
    if (used < 0 || used > RESP_CAP - 200) break;
  }
  snprintf(g_resp + used, RESP_CAP - used, "]}");
  WiFi.scanDelete();
  web.send(200, "application/json; charset=utf-8", g_resp);
}

static void handle_wifi_save() {
  String ssid = web.arg("ssid");
  String pass = web.arg("pass");
  ssid.trim();
  if (!ssid.length()) {
    web.send(400, "application/json; charset=utf-8",
             "{\"ok\":0,\"error\":\"ssid required\"}");
    return;
  }
  // Blank password on the already-saved network means "keep it"; on any other
  // network it means an open one, which is a legitimate choice.
  if (!(pass.length() == 0 && ssid == g_sta_ssid && g_sta_pass.length()))
    g_sta_pass = pass;
  g_sta_ssid = ssid;

  g_prefs.begin("wifi", false);
  g_prefs.putString("ssid", g_sta_ssid);
  g_prefs.putString("pass", g_sta_pass);
  g_prefs.end();

  WiFi.disconnect();
  delay(100);
  bool ok = sta_connect_saved(12000);
  if (ok) start_mdns_once();

  char esc[128];
  json_escape(g_sta_ssid.c_str(), g_sta_ssid.length(), esc, sizeof(esc));
  snprintf(g_resp, RESP_CAP, "{\"ok\":%d,\"ssid\":\"%s\",\"ip\":\"%s\",\"rssi\":%d}",
           ok ? 1 : 0, esc, WiFi.localIP().toString().c_str(),
           ok ? (int)WiFi.RSSI() : 0);
  Serial.printf("wifi : portal saved \"%s\" -> %s\n", g_sta_ssid.c_str(),
                ok ? "connected" : "failed");
  web.send(200, "application/json; charset=utf-8", g_resp);
}

static void handle_wifi_forget() {
  g_prefs.begin("wifi", false);
  g_prefs.remove("ssid");
  g_prefs.remove("pass");
  g_prefs.end();
  g_sta_ssid = "";
  g_sta_pass = "";
  WiFi.disconnect();
  Serial.println("wifi : credentials forgotten");
  web.send(200, "application/json; charset=utf-8", "{\"ok\":1}");
}

// ---- OpenAI-compatible endpoint --------------------------------------------
// The board is now its own API server: /v1/chat/completions takes the JSON the
// SDKs send, tokenizes the opening with the board's own BPE tables and answers
// with a story. Generation is synchronous here because the WebServer is a
// single-threaded handler: one request owns the board for ~35 s, and anything
// arriving meanwhile gets 503 instead of silently queueing.
#define API_MODEL "esp32-zh-story4"

static const char *skip_ws(const char *p) {
  while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') p++;
  return p;
}

static int hex_val(char c) {
  if (c >= '0' && c <= '9') return c - '0';
  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
  return -1;
}

static void put_utf8(char *out, int cap, int &o, unsigned cp) {
  if (cp < 0x80) {
    if (o < cap) out[o] = (char)cp;
    o += 1;
  } else if (cp < 0x800) {
    if (o + 1 < cap) {
      out[o] = (char)(0xC0 | (cp >> 6));
      out[o + 1] = (char)(0x80 | (cp & 0x3F));
    }
    o += 2;
  } else if (cp < 0x10000) {
    if (o + 2 < cap) {
      out[o] = (char)(0xE0 | (cp >> 12));
      out[o + 1] = (char)(0x80 | ((cp >> 6) & 0x3F));
      out[o + 2] = (char)(0x80 | (cp & 0x3F));
    }
    o += 3;
  } else {
    if (o + 3 < cap) {
      out[o] = (char)(0xF0 | (cp >> 18));
      out[o + 1] = (char)(0x80 | ((cp >> 12) & 0x3F));
      out[o + 2] = (char)(0x80 | ((cp >> 6) & 0x3F));
      out[o + 3] = (char)(0x80 | (cp & 0x3F));
    }
    o += 4;
  }
}

// Reads one JSON string starting at the opening quote; returns the position
// after the closing quote, or NULL when the text is malformed. \\uXXXX (and
// surrogate pairs) are decoded to UTF-8 because the SDKs escape non-ASCII.
static const char *json_read_string(const char *p, char *out, int cap) {
  if (*p != '"') return NULL;
  p++;
  int o = 0;
  while (*p && *p != '"') {
    if (*p != '\\') {
      if (o < cap - 1) out[o] = *p;
      o++;
      p++;
      continue;
    }
    p++;
    if (!*p) return NULL;
    if (*p == 'u') {
      if (!p[1] || !p[2] || !p[3] || !p[4]) return NULL;
      unsigned cp = 0;
      for (int k = 1; k <= 4; k++) {
        int h = hex_val(p[k]);
        if (h < 0) return NULL;
        cp = (cp << 4) | (unsigned)h;
      }
      p += 5;
      if (cp >= 0xD800 && cp <= 0xDBFF && p[0] == '\\' && p[1] == 'u') {
        unsigned lo = 0;
        bool ok = true;
        for (int k = 2; k <= 5; k++) {
          int h = hex_val(p[k]);
          if (h < 0) { ok = false; break; }
          lo = (lo << 4) | (unsigned)h;
        }
        if (ok && lo >= 0xDC00 && lo <= 0xDFFF) {
          cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
          p += 6;
        }
      }
      put_utf8(out, cap - 1, o, cp);
      continue;
    }
    char c = *p;
    if (c == 'n') c = '\n';
    else if (c == 't') c = '\t';
    else if (c == 'r') c = '\r';
    else if (c == 'b') c = '\b';
    else if (c == 'f') c = '\f';
    if (o < cap - 1) out[o] = c;
    o++;
    p++;
  }
  if (o > cap - 1) o = cap - 1;
  out[o] = 0;
  return (*p == '"') ? p + 1 : NULL;
}

// ---- request body -> prompt ------------------------------------------------
// Clients disagree about how a chat turn is encoded: the classic
// {"role":"user","content":"一天，"} and the parts form
// {"role":"user","content":[{"type":"text","text":"一天，"}]} are both in the
// wild (the OpenAI SDKs switched to the latter once vision/tool support
// landed). Only the last user turn is worth priming on, because this model
// cannot follow instructions: a system prompt would simply be continued as if
// it were the story. That is why the old "last content in the body" scan has
// been replaced by a small walk over the messages array.
//
// This is a scanner, not a parser: it skips over string bodies, so a quoted
// "content" inside a message cannot confuse it.

// Position after the string that starts at p (p must point at a quote).
static const char *json_skip_string(const char *p) {
  if (*p != '"') return NULL;
  p++;
  while (*p && *p != '"') {
    if (*p == '\\' && p[1]) p++;
    p++;
  }
  return (*p == '"') ? p + 1 : p;
}

// Position after one JSON value; nesting of the same bracket kind is tracked.
static const char *json_skip_value(const char *p) {
  p = skip_ws(p);
  if (*p == '"') return json_skip_string(p);
  if (*p == '[' || *p == '{') {
    const char open = *p;
    const char close = (open == '[') ? ']' : '}';
    int depth = 0;
    while (*p) {
      if (*p == '"') { p = json_skip_string(p); continue; }
      if (*p == open) depth++;
      else if (*p == close && --depth <= 0) return p + 1;
      p++;
    }
    return p;
  }
  while (*p && *p != ',' && *p != '}' && *p != ']' &&
         *p != ' ' && *p != '\t' && *p != '\r' && *p != '\n') p++;
  return p;
}

// Value of "key": ... inside [begin,end); NULL when the key is absent.
static const char *json_key_value(const char *begin, const char *end, const char *key) {
  const size_t klen = strlen(key);
  const char *p = begin;
  while (p < end) {
    if (*p != '"') { p++; continue; }
    const char *q = json_skip_string(p);
    if (!q || q > end) return NULL;
    if ((size_t)(q - p) == klen + 2 && !strncmp(p + 1, key, klen)) {
      const char *v = skip_ws(q);
      if (*v == ':') return skip_ws(v + 1);
    }
    p = q;
  }
  return NULL;
}

// Copies the text of a content/prompt value: a plain string, or an array of
// parts/strings (only the "text" fields of parts are used). Returns bytes.
static int json_value_text(const char *v, char *out, int cap) {
  int o = 0;
  out[0] = 0;
  if (!v || cap < 2) return 0;

  if (*v == '"') {
    char tmp[192];
    if (!json_read_string(v, tmp, sizeof(tmp))) return 0;
    while (tmp[o] && o < cap - 1) { out[o] = tmp[o]; o++; }
    out[o] = 0;
    return o;
  }
  if (*v != '[') return 0;

  const char *p = v + 1;
  for (;;) {
    p = skip_ws(p);
    if (*p == ',') { p++; continue; }
    if (!*p || *p == ']') break;
    if (*p == '"') {
      char tmp[192];
      const char *q = json_read_string(p, tmp, sizeof(tmp));
      if (!q) break;
      for (int i = 0; tmp[i] && o < cap - 1; i++) out[o++] = tmp[i];
      out[o] = 0;
      p = q;
      continue;
    }
    if (*p == '{') {
      const char *obj_end = json_skip_value(p);
      if (!obj_end) break;
      const char *t = json_key_value(p, obj_end, "text");
      if (t && *t == '"') {
        char tmp[192];
        if (json_read_string(t, tmp, sizeof(tmp)))
          for (int i = 0; tmp[i] && o < cap - 1; i++) out[o++] = tmp[i];
        out[o] = 0;
      }
      p = obj_end;
      continue;
    }
    const char *next = json_skip_value(p);
    if (!next || next <= p) break;
    p = next;
  }
  return o;
}

// Last user turn of a chat body (falling back to the last turn of any role),
// or the top-level "prompt" of a /v1/completions body. Returns bytes copied.
static int json_extract_prompt(const String &body, char *out, int cap) {
  const char *base = body.c_str();
  out[0] = 0;

  const char *msgs = strstr(base, "\"messages\"");
  if (msgs) {
    const char *p = strchr(msgs, '[');
    if (p) {
      char any[192] = {0};
      int n_user = 0, n_any = 0;
      p++;
      for (;;) {
        p = skip_ws(p);
        if (*p == ',') { p++; continue; }
        if (!*p || *p == ']') break;
        if (*p != '{') {
          const char *next = json_skip_value(p);
          if (!next || next <= p) break;
          p = next;
          continue;
        }
        const char *obj_end = json_skip_value(p);
        if (!obj_end) break;

        char role[16] = {0};
        const char *rv = json_key_value(p, obj_end, "role");
        if (rv && *rv == '"') json_read_string(rv, role, sizeof(role));

        const char *cv = json_key_value(p, obj_end, "content");
        if (cv) {
          n_any = json_value_text(cv, any, sizeof(any));
          if (!strcmp(role, "user")) n_user = json_value_text(cv, out, cap);
        }
        p = obj_end;
      }
      if (n_user > 0) return n_user;
      if (n_any > 0) {
        snprintf(out, cap, "%s", any);
        return (int)strlen(out);
      }
    }
  }

  const char *pv = strstr(base, "\"prompt\"");
  if (!pv) return 0;
  const char *q = skip_ws(pv + 8);
  if (*q != ':') return 0;
  return json_value_text(skip_ws(q + 1), out, cap);
}

static bool json_find_true(const String &body, const char *key) {
  char keybuf[32];
  snprintf(keybuf, sizeof(keybuf), "\"%s\"", key);
  const char *p = strstr(body.c_str(), keybuf);
  if (!p) return false;
  p = skip_ws(p + strlen(keybuf));
  if (*p != ':') return false;
  p = skip_ws(p + 1);
  return strncmp(p, "true", 4) == 0;
}

static void api_send_error(int code, const char *msg) {
  // Escaped, not pasted: the hint below quotes JSON, and an unescaped quote
  // would turn the error into a body the client cannot parse.
  char esc[256];
  json_escape(msg, (int)strlen(msg), esc, sizeof(esc));
  snprintf(g_resp, RESP_CAP,
           "{\"error\":{\"message\":\"%s\",\"type\":\"invalid_request_error\"}}", esc);
  web.sendHeader("Access-Control-Allow-Origin", "*");
  web.send(code, "application/json; charset=utf-8", g_resp);
}

static void handle_models() {
  web.sendHeader("Access-Control-Allow-Origin", "*");
  web.send(200, "application/json; charset=utf-8",
           "{\"object\":\"list\",\"data\":[{\"id\":\"" API_MODEL "\","
           "\"object\":\"model\",\"created\":0,\"owned_by\":\"esp32\"}]}");
}

static void handle_options() {
  web.sendHeader("Access-Control-Allow-Origin", "*");
  web.sendHeader("Access-Control-Allow-Headers", "*");
  web.sendHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
  web.send(204, "text/plain", "");
}

static void handle_completions() {
  if (g_running) { api_send_error(503, "board busy: one story at a time"); return; }

  String body = web.arg("plain");
  if (body.length() == 0) {
    // WebServer collects a body only when Content-Length is present, so this is
    // also what a chunked request looks like from up here.
    api_send_error(400, "empty request body: POST JSON with a Content-Length header");
    return;
  }

  char prompt[192] = {0};
  if (json_extract_prompt(body, prompt, sizeof(prompt)) == 0) {
    // Never silently fall back to the baked-in "一天，": that made every client
    // whose JSON this firmware did not understand look like it had a fixed
    // prompt of its own.
    api_send_error(400, "no message text in request body: send {\"messages\":[{\"role\":"
                        "\"user\",\"content\":\"一天，\"}]} or {\"prompt\":\"一天，\"}");
    return;
  }

  // A message longer than the 32-id prompt buffer is still a usable opening:
  // keep its first tokens instead of refusing the request.
  uint16_t wide[256];
  int n = bpe_encode((const uint8_t *)prompt, (int)strlen(prompt), wide, 256);
  if (n < 0) n = 256;
  if (n == 0) { api_send_error(400, "message text has no tokens"); return; }
  if (n > SERIAL_PROMPT_MAX) n = SERIAL_PROMPT_MAX;

  for (int i = 0; i < n; i++) g_prompt[i] = (int)wide[i];
  g_prompt_n = n;

  g_running = true;
  g_len = 0;
  if (g_text) g_text[0] = 0;
  g_story_start = 0;
  generate_story();       // blocking: the web server is busy for ~35 s
  g_running = false;

  int start = g_story_start;
  if (start < 0 || start > g_len) start = 0;
  int len = g_len - start;
  // The corpus closes documents with a newline, so the last token is often one;
  // trim it so API users get the story and not a stray line break.
  while (len > 0 && (g_text[start + len - 1] == '\n' || g_text[start + len - 1] == '\r')) len--;
  const char *text = g_text + start;
  unsigned long now = millis() / 1000;

  web.sendHeader("Access-Control-Allow-Origin", "*");
  if (json_find_true(body, "stream")) {
    // No token-by-token SSE: the story is ready before the first byte goes out,
    // but the chunked shape keeps streaming clients working.
    web.chunkResponseBegin("text/event-stream; charset=utf-8");
    int o = snprintf(g_resp, RESP_CAP,
                     "data: {\"id\":\"chatcmpl-%lu\",\"object\":\"chat.completion.chunk\","
                     "\"created\":%lu,\"model\":\"" API_MODEL "\",\"choices\":[{\"index\":0,"
                     "\"delta\":{\"role\":\"assistant\",\"content\":\"",
                     now, now);
    json_escape(text, len, g_resp + o, RESP_CAP - o - 128);
    strcat(g_resp, "\"},\"finish_reason\":null}]}\n\n");
    web.sendContent(g_resp);

    snprintf(g_resp, RESP_CAP,
             "data: {\"id\":\"chatcmpl-%lu\",\"object\":\"chat.completion.chunk\","
             "\"created\":%lu,\"model\":\"" API_MODEL "\",\"choices\":[{\"index\":0,"
             "\"delta\":{},\"finish_reason\":\"stop\"}]}\n\n", now, now);
    web.sendContent(g_resp);
    web.sendContent("data: [DONE]\n\n");
    web.chunkResponseEnd();
  } else {
    int o = snprintf(g_resp, RESP_CAP,
                     "{\"id\":\"chatcmpl-%lu\",\"object\":\"chat.completion\","
                     "\"created\":%lu,\"model\":\"" API_MODEL "\",\"choices\":[{\"index\":0,"
                     "\"message\":{\"role\":\"assistant\",\"content\":\"",
                     now, now);
    json_escape(text, len, g_resp + o, RESP_CAP - o - 256);
    size_t used = strlen(g_resp);
    snprintf(g_resp + used, RESP_CAP - used,
             "\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":%d,"
             "\"completion_tokens\":%d,\"total_tokens\":%d}}",
             n, (int)g_last_tokens, n + (int)g_last_tokens);
    web.send(200, "application/json; charset=utf-8", g_resp);
  }
}

static void start_network() {
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(AP_SSID, AP_PASS);
  web.on("/", handle_root);
  web.on("/start", handle_start);
  web.on("/text", handle_text);
  web.on("/v1/models", HTTP_GET, handle_models);
  web.on("/v1/chat/completions", HTTP_POST, handle_completions);
  web.on("/v1/completions", HTTP_POST, handle_completions);
  web.on("/v1/chat/completions", HTTP_OPTIONS, handle_options);
  web.on("/v1/completions", HTTP_OPTIONS, handle_options);
  web.on("/wifi", HTTP_GET, handle_wifi_page);
  web.on("/wifi/status", HTTP_GET, handle_wifi_status);
  web.on("/wifi/scan", HTTP_GET, handle_wifi_scan);
  web.on("/wifi/save", HTTP_POST, handle_wifi_save);
  web.on("/wifi/forget", HTTP_POST, handle_wifi_forget);
  web.begin();
  Serial.printf("wifi : AP \"%s\" / \"%s\"  ip %s\n", AP_SSID, AP_PASS,
                WiFi.softAPIP().toString().c_str());
  Serial.println("web  : http://192.168.4.1/");

  // Join the home network when credentials were stored with "W <ssid> <pass>".
  // AP+STA coexist, so the board keeps its own access point either way.
  if (g_sta_ssid.length()) {
    Serial.printf("wifi : joining \"%s\" ...\n", g_sta_ssid.c_str());
    if (sta_connect_saved(12000)) {
      IPAddress ip = WiFi.localIP();
      Serial.printf("wifi : STA ip %s\n", ip.toString().c_str());
      Serial.printf("api  : http://%s/v1  (any device on that WiFi)\n", ip.toString().c_str());
      start_mdns_once();
    } else {
      Serial.println("wifi : STA failed, access point only");
    }
  }
}
#endif

// Emit one token to every active output (serial always; panel when enabled).
static void emit(int tok) {
  if (tok >= VOCAB_N) return;
  const unsigned char *bytes = VOCAB_BLOB + VOCAB_OFF[tok];
  int len = VOCAB_OFF[tok + 1] - VOCAB_OFF[tok];
  // Non-blocking: when no host is draining the USB-CDC buffer (running as a
  // standalone gadget on the display), skip the write instead of stalling the
  // whole generation once the TX buffer fills. A framed API run is the opposite
  // case: the host is reading, and a dropped token would corrupt the text it is
  // serving, so that path writes unconditionally.
  if (g_mute_serial) {
    // prompt priming: panel and web text only, the wire stays clean
  } else if (g_framed) {
    Serial.write(bytes, len);
  } else if ((int)Serial.availableForWrite() >= len) {
    Serial.write(bytes, len);
  }
#if USE_DISPLAY
  display_puts(bytes, len);
#endif
#if ENABLE_WIFI
  // The web page polls for everything past the offset it already has, so the
  // story only needs to be accumulated, not pushed.
  if (g_text && g_len + len < TEXT_CAP) {
    memcpy(g_text + g_len, bytes, len);
    g_len += len;
    g_text[g_len] = 0;
  }
#endif
}

// Repetition-penalty bookkeeping: one bit per token id (16384 vocab -> 2KB
// static SRAM). A token is penalized once, however often it appears.
#define VOCAB_BITMAP_BYTES ((VOCAB_N + 7) / 8)
static uint8_t seen[VOCAB_BITMAP_BYTES];

static inline void seen_mark(int tok) {
  seen[tok >> 3] |= (uint8_t)(0x80u >> (tok & 7));
}
static inline int seen_has(int tok) {
  return seen[tok >> 3] & (0x80u >> (tok & 7));
}

// ---- sampler ---------------------------------------------------------------
// xorshift32, seeded from the hardware RNG once per story. Cheap, no libc state,
// and independent of how many tokens the previous run emitted.
static uint32_t g_rng;

static inline uint32_t rng_next() {
  uint32_t x = g_rng;
  x ^= x << 13;
  x ^= x >> 17;
  x ^= x << 5;
  return g_rng = x;
}
static inline float rng_unit() {  // [0, 1)
  return (rng_next() >> 8) * (1.0f / 16777216.0f);
}

#if SAMPLE_TOP_K > 1
// Temperature + top-k. One pass over the vocab keeps a descending k-window, so
// only the k candidates above the cut-off go through expf; the scan is trivial
// next to the head that produced the logits. EOT (id 0) stays a normal candidate
// once the story is long enough, which is how the model closes a piece.
static int sample_token(const float *logits, int n, bool allow_eot) {
  float top[SAMPLE_TOP_K];
  int k = 0;
  for (int v = 0; v < n; v++) {
    const float x = logits[v];
    if (k < SAMPLE_TOP_K) {
      int j = k++;
      while (j > 0 && top[j - 1] < x) { top[j] = top[j - 1]; j--; }
      top[j] = x;
    } else if (x > top[SAMPLE_TOP_K - 1]) {
      int j = SAMPLE_TOP_K - 1;
      while (j > 0 && top[j - 1] < x) { top[j] = top[j - 1]; j--; }
      top[j] = x;
    }
  }
  const float cut = top[k - 1], mx = top[0];
  float w[SAMPLE_TOP_K];
  int ids[SAMPLE_TOP_K], m = 0;
  float sum = 0.f;
  for (int v = 0; v < n && m < k; v++) {
    if (logits[v] < cut) continue;
    if (v == 0 && !allow_eot) continue;
    const float e = expf((logits[v] - mx) / SAMPLE_TEMP);
    w[m] = e;
    ids[m] = v;
    sum += e;
    m++;
  }
  if (m == 0) {  // every candidate above the cut-off was EOT: take the best word
    int best = 1;
    float bv = -1e30f;
    for (int v = 1; v < n; v++)
      if (logits[v] > bv) { bv = logits[v]; best = v; }
    return best;
  }
  if (m == 1) return ids[0];
  float r = rng_unit() * sum;
  for (int i = 0; i < m; i++) {
    r -= w[i];
    if (r <= 0.f) return ids[i];
  }
  return ids[m - 1];
}
#endif

// One story from the bundled prompt to EOT. Callable from setup (serial
// only) and from the web task; every output is fed through emit().
static void generate_story() {
#if USE_DISPLAY
  display_home();
#endif
  // A framed run is an API request: the prompt arrived on the control channel,
  // the story starts after <<<BEGIN and the prompt ids never touch the wire.
  const bool framed = g_framed;
  g_framed = false;
  int n_prompt = g_prompt_n;
  const int *prompt = g_prompt;
  if (n_prompt <= 0) {
    n_prompt = sizeof(PROMPT_IDS) / sizeof(int);
    prompt = PROMPT_IDS;
  }
  g_prompt_n = 0;  // one-shot: a later web request goes back to the baked prompt

  if (framed) Serial.print("<<<BEGIN\n");
  else        Serial.print(">>> ");
  int pos = 0, tok = 0;
  int64_t decode_us = 0;
  int decoded = 0;

  memset(seen, 0, sizeof(seen));  // fresh story, fresh penalty state
  g_rng = esp_random() | 1u;      // and a fresh seed: no run repeats the last one
  g_mute_serial = framed;
  for (int i = 0; i < n_prompt; i++) {  // prime with the prompt
    tok = prompt[i];
    seen_mark(tok);
    emit(tok);
    llm_forward(&model, tok, pos++, &s);
    delay(0);  // a 32-token prompt is ~10 s of prefill; keep the idle task fed
  }
  g_mute_serial = false;
#if ENABLE_WIFI
  // Everything before this offset is the caller's prompt; API replies carry
  // only what the model wrote after it.
  g_story_start = g_len;
#endif

  llm_profile_reset(&s);

  int64_t t_start = esp_timer_get_time();
  for (int step = 0; step < N_GENERATE && pos < DEV_SEQ; step++) {
#if REPETITION_PENALTY_PCT != 100
    // CTRL-style penalty over every token seen so far. Applied to a fresh
    // logits buffer each step, so penalties never accumulate. Must stay in
    // lockstep with generate(repetition_penalty=...) in src/model.py.
    for (int v = 0; v < model.out_vocab; v++) {
      if (seen_has(v)) {
        s.logits[v] = (s.logits[v] > 0.f)
                          ? s.logits[v] / REPETITION_PENALTY
                          : s.logits[v] * REPETITION_PENALTY;
      }
    }
#endif
#if SAMPLE_TOP_K > 1
    const int best = sample_token(s.logits, model.out_vocab, step >= MIN_STORY_TOKENS);
#else
    int best = 0; float bv = -1e30f;
    for (int v = 0; v < model.out_vocab; v++)
      if (s.logits[v] > bv) { bv = s.logits[v]; best = v; }
#endif
    if (best == 0) break;  // end-of-text token: the model closed the story
    tok = best;
    seen_mark(tok);
    emit(tok);
    blink((step & 1) ? 40 : 8);

    int64_t d0 = esp_timer_get_time();
    llm_forward(&model, tok, pos++, &s);
    decode_us += esp_timer_get_time() - d0;
    decoded++;
    if ((step & 1) == 0) delay(0);  // yield to the web task every two tokens
  }
  // Close the API frame as soon as the last token is on the wire; the stats
  // below belong to the human-facing serial log, not to the streamed story.
  if (framed) Serial.print("\n<<<END\n");

  g_last_tokens = decoded;
  int64_t total_us = esp_timer_get_time() - t_start;

  if (!framed) {

  Serial.printf("\n\n--- %d tokens in %.2f s ---\n", decoded, total_us / 1e6);
  Serial.printf("throughput: %.2f tok/s   (%.1f ms/token)\n",
                decoded * 1e6 / total_us, decode_us / 1000.0 / decoded);
  if (s.profile.calls) {
    float n = (float)s.profile.calls * 1000.f;
    Serial.printf("profile ms/token: input %.1f | attn %.1f | ffn %.1f | ple %.1f | head %.1f\n",
                  s.profile.input_us / n, s.profile.attn_us / n,
                  s.profile.ffn_us / n, s.profile.ple_us / n,
                  s.profile.head_us / n);
  }
  }
#if USE_DISPLAY
  display_stats(decoded * 1e6f / decode_us, decode_us / 1000.0f / decoded);
#endif
#if ENABLE_WIFI
  if (decoded > 0) {
    g_tok_s = decoded * 1e6f / (float)total_us;
    g_ms = decode_us / 1000.0f / (float)decoded;
  }
#endif
  blink(0);
}

#if ENABLE_WIFI
static void gen_task(void *) {
  generate_story();
  g_running = false;
  vTaskDelete(NULL);
}
#endif

void setup() {
  Serial.begin(115200);
  delay(1500);
  Serial.println("\n=== ESP32-S3 PLE TinyLM ===");

  const esp_partition_t *part = esp_partition_find_first(
      ESP_PARTITION_TYPE_DATA, (esp_partition_subtype_t)0x40, "model");
  if (!part) { Serial.println("model partition not found"); return; }
  const void *base;
  esp_partition_mmap_handle_t h;
  esp_err_t err = esp_partition_mmap(part, 0, part->size,
                                     ESP_PARTITION_MMAP_DATA, &base, &h);
  if (err != ESP_OK) { Serial.printf("mmap failed: %d\n", err); return; }

  if (llm_load((const uint8_t *)base, &model)) { Serial.println("bad model magic"); return; }
  Cfg *c = &model.c;
  Serial.printf("model: Vin=%d Vout=%d D=%d L=%d H=%d F=%d P=%d  (mapped %.1f MB)\n",
                c->vocab, model.out_vocab, c->dim, c->n_layers, c->n_heads,
                c->ffn, c->ple_dim, part->size / 1e6);

#if USE_DISPLAY
  display_begin();
#endif

  // The model header states how many logits it produces; vocab.h carries the
  // decode table. If they disagree, every emitted token would be decoded
  // against the wrong table.
  if (VOCAB_N != model.out_vocab) {
    Serial.printf("FATAL: tokenizer/model mismatch: vocab.h %d, model %d\n",
                  VOCAB_N, model.out_vocab);
    return;
  }

  alloc_scratch();
  copy_norms_to_sram();
  Serial.printf("hot set-> SRAM   %u B dynamic + %u B static = %u B managed\n",
                (unsigned)sram_used, (unsigned)STATIC_SRAM_BYTES,
                (unsigned)(sram_used + STATIC_SRAM_BYTES));

  // Stage every per-position tensor to int8 in PSRAM.
  int want = llm_core_stage_count(&model);
  int staged = llm_stage_core_int8_alloc(&model, ps);
  if (staged != want) {
    Serial.printf("FATAL: staged %d/%d core tensors\n", staged, want);
    while (1) delay(1000);
  }
#if STAGE_HEAD_INT8
  // The tied head is read per token, not per position, so the core helper does
  // not walk it. Stage it too: it is 85%% of the dense MACs. The English model
  // does this; the Chinese model cannot afford the 3.15MB (see STAGE_HEAD_INT8
  // above) and runs the head straight from flash int4 via the w8==NULL path.
  {
    void *b = ps_or_die(llm_stage_int8_bytes(&model.out_head), "staged head");
    llm_stage_int8(&model.out_head, b);
    ++staged;
  }
#endif
  Serial.printf("weights-> PSRAM  %d tensors int8, %.2f MB allocated\n",
                staged, psram_used / 1048576.0);

  if (xTaskCreatePinnedToCore(worker_main, "mv", 4096, NULL, 2, &worker_h, 0) == pdPASS) {
    // After the worker exists: matvec_par notifies worker_h.
    model.layer_matvec = matvec_par;
    model.head_matvec  = matvec_par;
  } else {
    Serial.println("dual-core worker failed; running single core");
  }

  // FNV-1a over the mapped image. scripts/deploy.sh prints the same value for
  // the file it flashed; the two must agree.
  {
    const uint8_t *img = (const uint8_t *)base;
    uint32_t fp = 2166136261u;
    for (size_t i = 0; i < model.image_bytes; i++) { fp ^= img[i]; fp *= 16777619u; }
    Serial.printf("build: bytes=%u fp=%08x sram=%uB psram=%.2fMB\n",
                  (unsigned)model.image_bytes, fp,
                  (unsigned)(sram_used + STATIC_SRAM_BYTES),
                  psram_used / 1048576.0);
  }
  Serial.printf("free: sram %.0f KB | psram %.2f MB\n\n",
                heap_caps_get_free_size(MALLOC_CAP_INTERNAL) / 1024.0,
                heap_caps_get_free_size(MALLOC_CAP_SPIRAM) / 1048576.0);

#if ENABLE_WIFI
  g_text = (char *)ps_or_die(TEXT_CAP, "story text");
  g_resp = (char *)ps_or_die(RESP_CAP, "http reply");
  g_text[0] = 0;

  g_prefs.begin("wifi", true);
  g_sta_ssid = g_prefs.getString("ssid", "");
  g_sta_pass = g_prefs.getString("pass", "");
  g_prefs.end();
  if (g_sta_ssid.length())
    Serial.printf("wifi : stored STA credentials for \"%s\"\n", g_sta_ssid.c_str());

  start_network();
#else
  generate_story();
#endif
}

void loop() {
#if ENABLE_WIFI
  web.handleClient();
  // Host commands arrive a byte at a time over USB-CDC; generation runs on the
  // other core, so this loop stays free to start the next request.
  while (Serial.available()) {
    int c = Serial.read();
    if (c == '\n' || c == '\r') {
      if (g_cmd_n) { g_cmd[g_cmd_n] = 0; handle_serial_line(g_cmd); g_cmd_n = 0; }
    } else if (g_cmd_n < (int)sizeof(g_cmd) - 1) {
      g_cmd[g_cmd_n++] = (char)c;
    } else {
      g_cmd_n = 0;  // overlong line: drop it rather than truncate a token id
    }
  }
  delay(2);
#else
  delay(10000);
#endif
}
